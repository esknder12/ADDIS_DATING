# Dategram environment template.
#
#   cp .env.example backend/.env      <- the API reads backend/.env (not the repo root)
#   npm run doctor                    <- checks every value below and tells you what is wrong
#
# Never commit backend/.env. It is ignored by Git.

# ──────────────────────────────────────────────────────────────────────────────
# PHASE 1 — required for a real Telegram launch
# ──────────────────────────────────────────────────────────────────────────────

# Token from @BotFather (/mybots → your bot → API Token). Looks like 123456789:AAF...
# Used to run the bot AND to verify every Mini App login signature — keep it secret.
BOT_TOKEN=

# Public HTTPS address of the frontend (port 3000). Telegram refuses http:// and localhost.
# Local testing: run `cloudflared tunnel --url http://localhost:3000` and paste the URL it prints.
WEBAPP_URL=

# PostgreSQL connection string. Tables are created automatically on first start.
#   Docker (compose.yaml):  postgresql://dategram:dategram@localhost:5432/dategram
#   Neon / Supabase / Railway: paste the string from the provider dashboard
DATABASE_URL=

# true for hosted databases (Neon, Supabase, Railway). Leave empty for Docker / local PostgreSQL.
DATABASE_SSL=

# ──────────────────────────────────────────────────────────────────────────────
# Optional
# ──────────────────────────────────────────────────────────────────────────────

# How old a Telegram launch may be before it is rejected (seconds). Default 86400 = 24h.
TELEGRAM_AUTH_MAX_AGE_SECONDS=

# Comma-separated browser origins allowed to call the API. Only enforced (and required)
# when NODE_ENV=production, e.g. https://app.example.com
CORS_ORIGINS=

# Long random secret for POST /api/admin/vip/grant (Phase 7). Endpoint stays disabled if empty.
ADMIN_API_KEY=

# Cloudinary credentials for profile photo uploads (Phase 9). Not needed for Phase 1.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Frontend (only if you need them — put these in frontend/.env.local, not backend/.env)
# ──────────────────────────────────────────────────────────────────────────────

# Where the Vite dev server proxies /api and /socket.io. Default http://127.0.0.1:4000
VITE_API_PROXY_TARGET=
# Absolute API origin for the browser. Leave empty to use relative /api URLs (recommended).
VITE_API_URL=
# Socket.IO origin override. Leave empty to reuse VITE_API_URL / same origin.
VITE_SOCKET_URL=
# Set to false to disable the browser-only demo identity in production builds.
VITE_ENABLE_DEMO_MODE=
