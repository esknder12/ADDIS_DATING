# Runtime
NODE_ENV=development
PORT=4000

# Telegram — get BOT_TOKEN from @BotFather
BOT_TOKEN=
WEBAPP_URL=https://your-mini-app.example.com
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# PostgreSQL
DATABASE_URL=postgresql://dategram:dategram@localhost:5432/dategram
DATABASE_SSL=false

# Comma-separated browser origins allowed to call the API.
# Leave blank in development to allow local preview origins.
CORS_ORIGINS=

# Phase 3 conversion flow
PROMO_DISCOUNT_PERCENT=50
PROMO_TTL_DAYS=7
# Salt for deterministic score/match-pool jitter. Changing it reshuffles scores.
SCORING_SECRET=

# Phase 4 verification
# Required to enable /api/admin/*. Leave blank and the admin router is not mounted at all.
ADMIN_API_TOKEN=
# Optional: Telegram file_id of an example round video note. It must have been uploaded
# through THIS bot — file_ids are bot-scoped and will not work from another bot.
VERIFICATION_EXAMPLE_VIDEO_ID=
