{
  "name": "dategram",
  "version": "0.1.0",
  "private": true,
  "description": "Dategram Telegram Mini App",
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run preview --workspace frontend",
    "test": "npm run test --workspace backend",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
