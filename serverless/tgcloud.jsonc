{
  // Project config for the tgcloud CLI.
  // Schema reference for editor support (after `npm install`):
  "$schema": "./node_modules/@tgcloud/cli/schema/tgcloud.json",

  // Mini App hosting ("Mini App Files" panel): `push` uploads ./webapp/
  // (copy of frontend/dist — see docs/ENDPOINTS.md) and serves it at
  // https://app<app_id>.tgcloud.ai/ . `spa` serves index.html for
  // extension-less routes (client-side routing).
  "static": {
    "source": "webapp",
    "spa": true
  }
}
